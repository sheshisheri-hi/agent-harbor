{
  "realm": "agentharbor",
  "enabled": true,
  "displayName": "AgentHarbor",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "agent-operator", "description": "Can list and invoke demo agents" },
      { "name": "agent-auditor", "description": "Read-only audit access" },
      { "name": "claims-analyst", "description": "Insurance claims demo tools" }
    ]
  },
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "email": "demo@agentharbor.local",
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "realmRoles": ["agent-operator", "claims-analyst"]
    }
  ],
  "clients": [
    {
      "clientId": "agentharbor-gateway",
      "name": "AgentHarbor Gateway",
      "enabled": true,
      "publicClient": false,
      "secret": "change-me-gateway-client-secret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": ["http://localhost:8080/*", "http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:8080"],
      "protocol": "openid-connect"
    },
    {
      "clientId": "agentharbor-ui",
      "name": "AgentHarbor UI",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "protocol": "openid-connect"
    }
  ]
}
