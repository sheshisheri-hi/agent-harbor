# AgentHarbor local demo — copy to .env and adjust. No production secrets.

# Postgres (Keycloak backing store)
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=keycloak

# Keycloak admin (dev only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin

# Service ports (host)
UI_PORT=3000
GATEWAY_PORT=8080
KEYCLOAK_PORT=8081
MCP_CLAIMS_PORT=8090

# Demo realm user (see keycloak/realm-agentharbor.json)
DEMO_USER=demo
DEMO_PASSWORD=demo
